{
  "expo": {
    "name": "WanderWise",
    "slug": "wanderwise-travel-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.wanderwise.travelplanner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "assets/adaptive-icon.png",
        "backgroundColor": "#176B55"
      }
    },
    "splash": {
      "image": "assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#176B55"
    },
    "plugins": [
      "expo-notifications"
    ],
    "scheme": "wanderwise",
    "icon": "assets/icon.png"
  }
}
